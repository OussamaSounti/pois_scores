# Morocco Spatial Dashboard — copy to .env and set values
# Do not commit .env; it may contain secrets.

# Database (production: existing DB; local: match Postgres and optional restore)
DATABASE_URL=postgresql://poi_user:poi_password@localhost:5432/poi_db

# Logging
LOG_LEVEL=info

# CORS (comma-separated origins; avoid * in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Feature pipeline: version written to property_features.pipeline_version (when running pipeline)
PIPELINE_VERSION=1.0

# Source transactions table for dashboard joins (dev: staging.transactions; prod: analytics.transactions)
TRANSACTIONS_TABLE=staging.transactions
